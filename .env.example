# Copy to .env and fill locally. Never commit credentials.
DB_URL=jdbc:postgresql://localhost:5432/leadit
DB_USERNAME=leadit
DB_PASSWORD=
LOCAL_DB_PASSWORD=
APP_PROFILE=migrations
APP_JOBS_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Email verification is optional; leave blank until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional policies (new loans only); ratios are between 0 and 1.
APP_FEES_STANDARD_DAILY_FINE=50.00
APP_FEES_VIP_DAILY_FINE=30.00
APP_FEES_STANDARD_GRACE_DAYS=0
APP_FEES_VIP_GRACE_DAYS=2
APP_FEES_SCRATCH_RATE=0.20
APP_FEES_DAMAGE_RATE=0.50
APP_FEES_LOSS_RATE=1.00
APP_PAGINATION_CATALOG_SIZE=12
APP_PAGINATION_REQUEST_SIZE=10
APP_PAGINATION_MANAGEMENT_SIZE=10
APP_PAGINATION_USER_SIZE=10
APP_PAGINATION_PROFILE_SIZE=5

# Set true after obtaining Google OAuth Web client credentials.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application URL for verification links; use your HTTPS URL when deployed.
APP_BASE_URL=http://localhost:8080

# HTTPS email delivery; MAIL_FROM must be verified in Brevo.
MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM=

# Organizational timezone and bounded login/signup protection (per web instance).
APP_BUSINESS_ZONE=Asia/Bangkok
APP_LOGIN_LIMIT=20
APP_REGISTRATION_LIMIT=10
APP_OVERDUE_ENABLED=true
